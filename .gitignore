# Generated data — the raw capture is the asset; it lives on disk, not in git.
raw/

# Normalized / enriched output and the consolidated applicable set.
out/

# Review exports (generated spreadsheets/CSVs for manual review).
outputs/

# Prior-session captures and working outputs (directories and their zip archives).
pull_*/
grid_*/
scratchpad/
scratch/
*.zip

# Local dev artifacts: one-off probes/fixtures + screenshot scripts. Kept on disk, not tracked.
aggregator_probe.jsonl
prerender/_gap.mjs

# Daily-pull run logs (ops/run_pull_daily.ps1).
logs/

# Python
__pycache__/
.venv/
*.pyc

.vercel
.env*

# Google Indexing API service-account key (never commit secrets)
secrets/
